# Telegram Bot API Token (obtain from @BotFather)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Google Gemini API Key (obtain from Google AI Studio)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
# Optional: Multiple API keys separated by comma for quota rotation
# GEMINI_API_KEYS=key1,key2

# Primary Gemini Model Name (recommended: gemini-3.5-flash-lite or gemini-3.7-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Pool of fallback models (comma-separated). If the primary model returns 429 RESOURCE_EXHAUSTED,
# 404 NOT_FOUND, or 503 UNAVAILABLE, the service will automatically failover to the next available model.
GEMINI_MODELS_POOL=gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# MongoDB connection settings (pymongo AsyncMongoClient)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=english_bot

# Default user timezone (e.g. UTC, Europe/Moscow, Europe/Kyiv, America/New_York)
DEFAULT_TIMEZONE=UTC

# Microsoft Edge TTS Neural Voice identifier
TTS_VOICE=en-US-AriaNeural

# Logging verbosity level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Web App & Mini App settings (for domain e.g. wb.qper.link)
WEBAPP_URL=https://wb.qper.link
WEB_HOST=0.0.0.0
WEB_PORT=8000
JWT_SECRET=generate_a_secure_random_string_here

