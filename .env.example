# ==========================================
# Telegram Bot & AI Credentials
# ==========================================
# Telegram Bot API Token (obtain from @BotFather)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Google Gemini API Key (obtain from Google AI Studio)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
# Optional: Multiple API keys separated by comma for quota rotation
# GEMINI_API_KEYS=key1,key2

# Primary Gemini Model Name (recommended: gemini-3.7-flash or gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.7-flash

# Pool of fallback models (comma-separated failover pool)
GEMINI_MODELS_POOL=gemini-3.7-flash,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.6-flash,gemini-2.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite

# ==========================================
# Database Configuration (MongoDB)
# ==========================================
# Local Development:
# MONGODB_URL=mongodb://localhost:27017
#
# Coolify Production (Native Database resource -> Internal URL):
# MONGODB_URL=mongodb://root:password@<coolify-mongo-uuid>:27017/english_bot?authSource=admin&directConnection=true
# (Also supports MONGO_URL or MONGODB_URI)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=english_bot

# ==========================================
# Localization & Voice (TTS)
# ==========================================
# Default user timezone (e.g. UTC, Europe/Kyiv, Europe/Warsaw, America/New_York)
DEFAULT_TIMEZONE=UTC

# TTS Engine: 'edge' (Microsoft Edge TTS) or 'gemini' (Gemini Neural TTS)
TTS_ENGINE=edge
# Edge TTS Neural Voice identifier (e.g. en-US-AriaNeural, en-GB-SoniaNeural)
TTS_VOICE=en-US-AriaNeural
# Gemini TTS Voice (Kore, Puck, Fenrir, Aoede, Charon, Enceladus) & Model
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ==========================================
# Web Server & WebApp Settings
# ==========================================
# Logging verbosity level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Public HTTPS URL of the WebApp / Dashboard configured in Coolify domain settings
WEBAPP_URL=https://wb.yourdomain.com
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Secret key for JWT session tokens (generate a long random secret in production)
JWT_SECRET=change_this_to_a_secure_random_string_in_production
